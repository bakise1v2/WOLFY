generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         String    @default("player") // "player" | "admin"
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  status         String   @default("lobby") // lobby | running | finished
  phase          String   @default("waiting") // waiting | night | day | voting | ended
  createdBy      String
  createdAt      DateTime @default(now())
  nightNumber    Int      @default(0)
  dayNumber      Int      @default(0)
  configJson     String // JSON string of role config
  playersJson    String // JSON string of players map
  historyJson    String   @default("[]")
  votesJson      String   @default("[]")
  eliminatedJson String   @default("[]")
  winners        String?
}
